mlruns/
.mlflow/

# ── Testing / Coverage ───────────────────────────────────────────────────────
*.log
.pytest_cache/
.coverage
htmlcov/

# ── DVC NOTE: Do NOT ignore these — they belong in git ───────────────────────
# *.dvc        ← pointer files, commit these
# .dvc/config  ← remote config, commit this
# .dvcignore   ← commit this
