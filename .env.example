# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Qdrant Cloud (qdrant.cloud) ───────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Redis (Railway addon URL or local) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Optional overrides ───────────────────────────────────────────────────────
BM25_CORPUS_PATH=data/cache/bm25_corpus.pkl

# ── Optional: Groq LLM fallback ──────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Local development / experiments only ─────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
